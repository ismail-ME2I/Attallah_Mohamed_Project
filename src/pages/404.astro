---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Page Not Found — Mohammed Attallah" description="The page you were looking for doesn't exist.">
  <section class="not-found">
    <div class="container">
      <p class="not-found__code">404</p>
      <h1 class="not-found__heading">This page doesn't exist.</h1>
      <p class="not-found__supporting">
        The page you were looking for may have moved, or the link may be incorrect.
      </p>
      <Button href="/" variant="primary">Return to Mohammed Attallah</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(70vh - 80px);
    padding-block: calc(var(--space-6) + 80px) var(--space-6);
  }

  .not-found__code {
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    color: var(--color-accent-primary);
  }

  .not-found__heading {
    margin-top: var(--space-2);
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-line);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    color: var(--color-text-primary);
  }

  .not-found__supporting {
    max-width: 50ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-secondary);
  }

  .not-found :global(.btn) {
    margin-top: var(--space-5);
  }

  @media (min-width: 1024px) {
    .not-found {
      min-height: calc(75vh - 80px);
      padding-block: calc(var(--space-8) + 80px) var(--space-7);
    }
  }
</style>
