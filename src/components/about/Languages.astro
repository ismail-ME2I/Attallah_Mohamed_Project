---
const languages = [
  { name: "Arabic", level: "Native" },
  { name: "English", level: "Professional Working" },
  { name: "Spanish", level: "Elementary" },
];
---

<section class="languages reveal" data-reveal aria-labelledby="languages-heading">
  <div class="container">
    <h2 id="languages-heading" class="languages__label">Languages</h2>
    <ul class="languages__list">
      {
        languages.map((lang) => (
          <li class="languages__item">
            <span class="languages__name">{lang.name}</span>
            <span class="languages__level">· {lang.level}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .languages {
    scroll-margin-top: 80px;
    padding-block: var(--space-3);
  }

  .languages__label {
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .languages__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .languages__item {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
  }

  .languages__name {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .languages__level {
    margin-inline-start: 2px;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .languages__list {
      flex-direction: row;
      gap: var(--space-4);
    }
  }
</style>
