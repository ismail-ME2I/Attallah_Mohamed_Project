---
import { certifications, education, recognitions } from "../../data/credentials";
---

<section class="credentials" aria-labelledby="credentials-heading">
  <div class="container">
    <h2 id="credentials-heading" class="credentials__heading reveal" data-reveal>
      Credentials
    </h2>
    <div class="credentials__groups">
      <div class="credentials__group">
        <p class="credentials__label reveal" data-reveal>
          Certifications
        </p>
        <ul class="credentials__list">
          {
            certifications.map((item) => (
              <li class="credentials__item reveal" data-reveal>
                <span class="credentials__title">{item.title}</span>
                {item.detail && <span class="credentials__detail">{item.detail}</span>}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="credentials__group">
        <p class="credentials__label reveal" data-reveal>
          Education
        </p>
        <ul class="credentials__list">
          {
            education.map((item) => (
              <li class="credentials__item reveal" data-reveal>
                <span class="credentials__title">{item.title}</span>
                {item.detail && <span class="credentials__detail">{item.detail}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="recognition" aria-labelledby="recognition-heading">
  <div class="container">
    <h2 id="recognition-heading" class="recognition__heading reveal" data-reveal>
      Recognition
    </h2>
    <ol class="recognition__list">
      {
        recognitions.map((item, index) => (
          <li class="recognition__item reveal" data-reveal>
            <span class="recognition__index">{String(index + 1).padStart(2, "0")}</span>
            <span class="recognition__title">{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .credentials {
    scroll-margin-top: 80px;
    padding-block: var(--space-5);
  }

  .recognition {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .credentials__heading,
  .recognition__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  /* Credential ledger — two clearly separated groups, each item a small
     titled row with a subtle copper rule, not a horizontal CV strip. */
  .credentials__groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .credentials__label {
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: var(--text-label-weight);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .credentials__list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
  }

  .credentials__item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: var(--space-2);
    padding-inline-start: var(--space-2);
    border-inline-start: 2px solid var(--color-accent-primary);
  }

  .credentials__item + .credentials__item {
    margin-top: var(--space-2);
  }

  .credentials__title {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .credentials__detail {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  /* Recognition — a short numbered editorial list, not a trophy card. */
  .recognition__list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
  }

  .recognition__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
  }

  .recognition__item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .recognition__index {
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-accent-primary);
  }

  .recognition__title {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .credentials__groups {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .credentials {
      padding-block: var(--space-6);
    }

    .credentials__groups {
      margin-top: var(--space-5);
    }
  }

  /* Small stagger within each list; the second group's label trails the
     first by one step so the two columns don't reveal in perfect unison. */
  @media (prefers-reduced-motion: no-preference) {
    .credentials__group:nth-child(2) .credentials__label {
      transition-delay: 90ms;
    }

    .credentials__item:nth-child(2) {
      transition-delay: 90ms;
    }

    .credentials__item:nth-child(3) {
      transition-delay: 180ms;
    }

    .credentials__item:nth-child(4) {
      transition-delay: 270ms;
    }

    .recognition__item:nth-child(2) {
      transition-delay: 90ms;
    }
  }
</style>
