---
import { aboutExperienceDomains } from "../../data/expertise";

const paragraph =
  "Mohammed's experience spans the full automation stack — from substation automation systems and IEC 61850 architecture to RTU/SCADA integration and data center automation, through to the site testing and commissioning work that brings a system from design to energization.";
---

<section class="experience" aria-labelledby="experience-heading">
  <div class="container">
    <h2 id="experience-heading" class="experience__heading reveal" data-reveal>
      From Automation Systems to Site Commissioning
    </h2>
    <p class="experience__paragraph reveal" data-reveal>
      {paragraph}
    </p>
    <ul class="experience__domains">
      {
        aboutExperienceDomains.map((domain, index) => (
          <li class="experience__domain reveal" data-reveal>
            <span class="experience__domain-index">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="experience__domain-title">{domain.title}</h3>
            <p class="experience__domain-terms">{domain.terms.join(" · ")}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .experience {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .experience__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .experience__paragraph {
    max-width: 60ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-primary);
  }

  /* Editorial domain groups — not service cards: no border-radius-as-card,
     no shadow, no hover/interactive affordance. Hairline rules only. */
  .experience__domains {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--space-4);
  }

  .experience__domain {
    padding-block: var(--space-3);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
  }

  .experience__domain:first-child {
    border-top: none;
    padding-top: 0;
  }

  .experience__domain-index {
    display: block;
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-accent-primary);
  }

  .experience__domain-title {
    margin-top: var(--space-1);
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--text-h3-weight);
    color: var(--color-text-primary);
  }

  .experience__domain-terms {
    margin-top: var(--space-1);
    max-width: 46ch;
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .experience__domains {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-5);
    }

    .experience__domain {
      padding-inline-start: var(--space-5);
      border-top: none;
      border-left: var(--border-width-hairline) solid var(--border-color-default);
    }

    .experience__domain:nth-child(odd) {
      padding-inline-start: 0;
      border-left: none;
    }

    .experience__domain:nth-child(1),
    .experience__domain:nth-child(2) {
      padding-top: 0;
    }

    .experience__domain:nth-child(n + 3) {
      padding-top: var(--space-3);
    }

    .experience__domain:nth-child(-n + 2) {
      border-top: none;
    }

    .experience__domain:nth-child(n + 3) {
      border-top: var(--border-width-hairline) solid var(--border-color-default);
    }
  }

  @media (min-width: 1024px) {
    .experience__paragraph {
      margin-top: var(--space-4);
    }

    .experience__domains {
      margin-top: var(--space-5);
    }
  }

  /* Domains reveal 01 → 02 → 03 → 04 with a small stagger. */
  @media (prefers-reduced-motion: no-preference) {
    .experience__domain:nth-child(2) {
      transition-delay: 90ms;
    }

    .experience__domain:nth-child(3) {
      transition-delay: 180ms;
    }

    .experience__domain:nth-child(4) {
      transition-delay: 270ms;
    }
  }
</style>
