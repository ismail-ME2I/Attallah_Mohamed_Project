---
import type { Fact } from "../../data/authority";

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<ol class="credential-index">
  {
    facts.map((fact, index) => (
      <li class="credential-index__item">
        <span class="credential-index__number">{String(index + 1).padStart(2, "0")}</span>
        <span class="credential-index__value">{fact.value}</span>
        {fact.label && <span class="credential-index__label">{fact.label}</span>}
      </li>
    ))
  }
</ol>

<style>
  /*
    Editorial credentials index — homepage Authority section only.
    Deliberately not the shared FactStrip component (which stays untouched
    for About/other pages): a numbered grid with row + column hairlines,
    closer to a professional index/directory than a stat strip.
  */
  .credential-index {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-5);
  }

  .credential-index__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
    transition: background-color var(--duration-fast) var(--easing-hover);
  }

  .credential-index__item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .credential-index__number {
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-muted);
  }

  .credential-index__value {
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--easing-hover);
  }

  .credential-index__label {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .credential-index {
      grid-template-columns: repeat(2, 1fr);
    }

    .credential-index__item {
      padding-inline-start: var(--space-5);
    }

    .credential-index__item:nth-child(odd) {
      padding-inline-start: 0;
    }

    .credential-index__item:nth-child(even) {
      border-left: var(--border-width-hairline) solid var(--border-color-default);
    }

    .credential-index__item:nth-child(1),
    .credential-index__item:nth-child(2) {
      border-top: none;
      padding-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .credential-index {
      grid-template-columns: repeat(3, 1fr);
    }

    .credential-index__item:nth-child(even) {
      border-left: none;
    }

    .credential-index__item:nth-child(3n + 2),
    .credential-index__item:nth-child(3n) {
      border-left: var(--border-width-hairline) solid var(--border-color-default);
      padding-inline-start: var(--space-5);
    }

    .credential-index__item:nth-child(3n + 1) {
      padding-inline-start: 0;
    }

    .credential-index__item:nth-child(3) {
      border-top: none;
      padding-top: 0;
    }
  }

  @media (hover: hover) {
    .credential-index__item:hover {
      background-color: var(--color-background-secondary);
    }

    .credential-index__item:hover .credential-index__value {
      color: var(--color-accent-primary);
    }
  }
</style>
