---
import CredentialIndex from "./CredentialIndex.astro";
import { authorityFacts } from "../../data/authority";

const narrative =
  "15+ years leading industrial and energy automation work — from utility regulation in Egypt to 15 years at Schneider Electric, most recently as Datacenter Automation Technical Leader.";
---

<section class="authority reveal" data-reveal aria-labelledby="authority-heading">
  <div class="container">
    <h2 id="authority-heading" class="visually-hidden">Authority</h2>
    <p class="authority__narrative">{narrative}</p>
    <div class="authority__facts">
      <CredentialIndex facts={authorityFacts} />
    </div>
  </div>
</section>

<style>
  .authority {
    /*
      Sprint 04.1 polish: section-to-section rhythm (D06 Section 7) is meant
      to read as ~space-7/space-6 TOTAL between adjacent sections' content.
      Each plain section contributes half (space-5/space-4) so two adjacent
      sections sum to the intended gap, instead of doubling it.
    */
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .authority__narrative {
    max-width: var(--container-reading);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-primary);
  }

  .authority__facts {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .authority {
      padding-block: var(--space-5);
    }

    .authority__facts {
      margin-top: var(--space-5);
    }
  }
</style>
