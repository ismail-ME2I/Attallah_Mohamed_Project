---
import Button from "../ui/Button.astro";
---

<section class="final-cta reveal" data-reveal aria-labelledby="final-cta-heading">
  <div class="container final-cta__inner">
    <h2 id="final-cta-heading" class="final-cta__heading">Where Would You Like to Start?</h2>
    <p class="final-cta__fragment">Solve a technical challenge, or build your automation skills.</p>
    <div class="final-cta__actions">
      <Button href="/easy-automation-academy" variant="primary">Explore Easy Automation Academy</Button>
      <Button href="/consulting" variant="secondary">Discuss a Technical Challenge</Button>
    </div>
  </div>
</section>

<style>
  .final-cta {
    scroll-margin-top: 80px;
    padding-block: var(--space-7);
  }

  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .final-cta__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .final-cta__fragment {
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-secondary);
  }

  .final-cta__actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 360px;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .final-cta__actions :global(.btn) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .final-cta__actions {
      flex-direction: row;
      max-width: none;
      width: auto;
    }

    .final-cta__actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .final-cta {
      padding-block: var(--space-8);
    }
  }
</style>
