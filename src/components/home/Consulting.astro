---
import Button from "../ui/Button.astro";
import ExpertisePillars from "./ExpertisePillars.astro";
import { homepageExpertisePillars } from "../../data/expertise";

const paragraph =
  "Mohammed's background spans substation automation, IEC 61850, RTU/SCADA, and data center automation architecture. If you're facing a real technical challenge in one of these areas, he's open to a conversation.";
---

<section class="consulting reveal" data-reveal aria-labelledby="consulting-heading">
  <div class="container">
    <div class="consulting__heading-row">
      <h2 id="consulting-heading" class="consulting__heading">Technical Consulting & Advisory</h2>
      <span class="consulting__qualifier">(scope &amp; availability to be confirmed)</span>
    </div>
    <p class="consulting__paragraph">{paragraph}</p>
    <div class="consulting__tags">
      <ExpertisePillars pillars={homepageExpertisePillars} />
    </div>
    <div class="consulting__cta">
      <Button href="/consulting" variant="secondary">Discuss a Technical Challenge</Button>
    </div>
  </div>
</section>

<style>
  .consulting {
    /* Sprint 04.1 polish: halved so adjacent sections sum to D06's intended
       space-7/space-6 section-to-section gap instead of doubling it. */
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .consulting__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
  }

  .consulting__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .consulting__qualifier {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  .consulting__paragraph {
    max-width: 60ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-primary);
  }

  .consulting__tags {
    margin-top: var(--space-3);
  }

  .consulting__cta {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .consulting {
      padding-block: var(--space-5);
    }

    .consulting__paragraph {
      margin-top: var(--space-4);
    }

    .consulting__tags {
      margin-top: var(--space-4);
    }

    .consulting__cta {
      margin-top: var(--space-5);
    }
  }
</style>
