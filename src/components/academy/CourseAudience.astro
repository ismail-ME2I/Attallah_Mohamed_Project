---
import ExpertiseTags from "../ui/ExpertiseTags.astro";
import { courseDetail } from "../../data/courseDetail";
---

<section class="course-audience reveal" data-reveal aria-labelledby="course-audience-heading">
  <div class="container">
    <h2 id="course-audience-heading" class="course-audience__heading">Who This Course Is For</h2>
    <div class="course-audience__tags">
      <ExpertiseTags tags={courseDetail.audience} />
    </div>
  </div>
</section>

<style>
  .course-audience {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .course-audience__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .course-audience__tags {
    margin-top: var(--space-3);
  }

  @media (min-width: 1024px) {
    .course-audience__tags {
      margin-top: var(--space-4);
    }
  }
</style>
