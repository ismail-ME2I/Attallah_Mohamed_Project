---
import { curriculum } from "../../data/courseDetail";

const typeLabel: Record<string, string> = {
  quiz: "Quiz",
  exercise: "Exercise",
};
---

<section class="course-curriculum reveal" data-reveal aria-labelledby="course-curriculum-heading">
  <div class="container">
    <h2 id="course-curriculum-heading" class="course-curriculum__heading">Curriculum</h2>
    <p class="course-curriculum__note">The complete course curriculum, in order.</p>

    <div class="course-curriculum__groups">
      {
        curriculum.map((group) => (
          <details class="curriculum-group" open>
            <summary class="curriculum-group__summary">
              <h3 class="curriculum-group__heading">{group.heading}</h3>
              <span class="curriculum-group__count">
                {group.items.length} {group.items.length === 1 ? "item" : "items"}
              </span>
            </summary>
            <ol class="curriculum-group__list">
              {group.items.map((item, index) => (
                <li class={`curriculum-item curriculum-item--${item.type}`}>
                  <span class="curriculum-item__index">{String(index + 1).padStart(2, "0")}</span>
                  {typeLabel[item.type] && <span class="curriculum-item__badge">{typeLabel[item.type]}</span>}
                  <span class="curriculum-item__label">{item.label}</span>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .course-curriculum {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .course-curriculum__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .course-curriculum__note {
    margin-top: var(--space-1);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-muted);
  }

  .course-curriculum__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .curriculum-group {
    border: var(--border-width-hairline) solid var(--border-color-default);
    border-radius: var(--radius-default);
  }

  .curriculum-group__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-3);
    cursor: pointer;
    list-style: none;
    background-color: var(--color-background-secondary);
    border-radius: var(--radius-default) var(--radius-default) 0 0;
  }

  .curriculum-group__summary::-webkit-details-marker {
    display: none;
  }

  .curriculum-group__summary:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }

  .curriculum-group[open] .curriculum-group__summary {
    border-bottom: var(--border-width-hairline) solid var(--border-color-default);
  }

  .curriculum-group__heading {
    margin: 0;
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: var(--text-h3-weight);
    color: var(--color-text-primary);
  }

  .curriculum-group__count {
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .curriculum-group__list {
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-3);
  }

  .curriculum-item {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-1);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-primary);
    transition: background-color var(--duration-fast) var(--easing-hover);
  }

  .curriculum-item:first-child {
    border-top: none;
  }

  .curriculum-item:hover {
    background-color: var(--color-background-secondary);
  }

  .curriculum-item__index {
    flex-shrink: 0;
    width: 2ch;
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    color: var(--color-text-muted);
  }

  .curriculum-item--module .curriculum-item__label {
    font-weight: 500;
  }

  .curriculum-item__badge {
    flex-shrink: 0;
    padding: 2px var(--space-1);
    border: var(--border-width-hairline) solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: 500;
    color: var(--color-accent-primary);
  }

  .curriculum-item__label {
    flex: 1;
  }

  .curriculum-item--quiz .curriculum-item__label,
  .curriculum-item--exercise .curriculum-item__label {
    color: var(--color-text-secondary);
  }
</style>
