---
import { courseDetail } from "../../data/courseDetail";

// Display-only split: the two items that carry a parenthetical clarifier
// ("Full Recorded Sessions (10+ Hours of Content)") render it as a
// secondary line instead of inline text. courseDetail.format itself is
// untouched — every original word is still present, just restructured
// for scanability.
const items = courseDetail.format.map((entry) => {
  const match = entry.match(/^(.*?)\s*\(([^)]+)\)$/);
  return match ? { title: match[1], detail: match[2] } : { title: entry, detail: null };
});
---

<section class="course-format reveal" data-reveal aria-labelledby="course-format-heading">
  <div class="container">
    <h2 id="course-format-heading" class="course-format__heading">Course Format</h2>
    <ol class="course-format__grid">
      {
        items.map((item, index) => (
          <li class="course-format__item">
            <span class="course-format__index">{String(index + 1).padStart(2, "0")}</span>
            <p class="course-format__title">{item.title}</p>
            {item.detail && <p class="course-format__detail">{item.detail}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .course-format {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .course-format__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  /* Editorial metadata grid — restrained copper index + hairline rules,
     deliberately not a card grid (no borders-as-boxes, no shadow, no icons). */
  .course-format__grid {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--space-4);
  }

  .course-format__item {
    padding-block: var(--space-3);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
  }

  .course-format__item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .course-format__index {
    display: block;
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-accent-primary);
  }

  .course-format__title {
    margin-top: var(--space-1);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .course-format__detail {
    margin-top: 2px;
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .course-format__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-5);
    }

    .course-format__item {
      padding-inline-start: var(--space-5);
      border-top: none;
      border-left: var(--border-width-hairline) solid var(--border-color-default);
    }

    .course-format__item:nth-child(odd) {
      padding-inline-start: 0;
      border-left: none;
    }

    .course-format__item:nth-child(1),
    .course-format__item:nth-child(2) {
      padding-top: 0;
    }

    .course-format__item:nth-child(n + 3) {
      border-top: var(--border-width-hairline) solid var(--border-color-default);
      padding-top: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .course-format__grid {
      grid-template-columns: repeat(3, 1fr);
      margin-top: var(--space-5);
    }

    .course-format__item {
      padding-top: 0;
    }

    .course-format__item:nth-child(2) {
      padding-inline-start: var(--space-5);
      border-left: var(--border-width-hairline) solid var(--border-color-default);
    }

    .course-format__item:nth-child(3n + 1) {
      padding-inline-start: 0;
      border-left: none;
    }

    .course-format__item:nth-child(3n + 2),
    .course-format__item:nth-child(3n) {
      padding-inline-start: var(--space-5);
      border-left: var(--border-width-hairline) solid var(--border-color-default);
    }

    .course-format__item:nth-child(1),
    .course-format__item:nth-child(2),
    .course-format__item:nth-child(3) {
      border-top: none;
    }

    .course-format__item:nth-child(n + 4) {
      border-top: var(--border-width-hairline) solid var(--border-color-default);
      padding-top: var(--space-3);
    }
  }
</style>
