---
import { courseDetail } from "../../data/courseDetail";
---

<section class="course-overview reveal" data-reveal aria-labelledby="course-overview-heading">
  <div class="container">
    <h2 id="course-overview-heading" class="course-overview__heading">Why This Course</h2>
    <div class="course-overview__quote">
      {courseDetail.whyThisCourse.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .course-overview {
    scroll-margin-top: 80px;
    padding-block: var(--space-5);
    background-color: var(--color-background-secondary);
  }

  .course-overview__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .course-overview__quote {
    max-width: 65ch;
    margin-top: var(--space-3);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent-primary);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .course-overview__quote p {
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-primary);
  }

  @media (min-width: 1024px) {
    .course-overview__quote {
      margin-top: var(--space-4);
    }
  }
</style>
