---
import ExpertiseTags from "../ui/ExpertiseTags.astro";
import { courseDetail } from "../../data/courseDetail";
---

<section class="practical-engineering reveal" data-reveal aria-labelledby="practical-engineering-heading">
  <div class="container">
    <div class="practical-engineering__panel">
      <h2 id="practical-engineering-heading" class="practical-engineering__heading">The Practical Dimension</h2>
      <p class="practical-engineering__intro">
        The course includes practical demonstrations and real engineering scenarios, including:
      </p>
      <div class="practical-engineering__divider" role="presentation"></div>
      <p class="practical-engineering__label">Includes</p>
      <div class="practical-engineering__tags">
        <ExpertiseTags tags={courseDetail.practicalItems} />
      </div>
    </div>
  </div>
</section>

<style>
  .practical-engineering {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .practical-engineering__panel {
    padding: var(--space-4);
    border-left: 3px solid var(--color-accent-primary);
    background-color: var(--color-background-secondary);
    border-radius: 0 var(--radius-default) var(--radius-default) 0;
  }

  .practical-engineering__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .practical-engineering__intro {
    max-width: 65ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-primary);
  }

  .practical-engineering__divider {
    margin-top: var(--space-4);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
  }

  .practical-engineering__label {
    margin-top: var(--space-3);
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-muted);
  }

  .practical-engineering__tags {
    margin-top: var(--space-2);
  }

  @media (min-width: 1024px) {
    .practical-engineering__panel {
      padding: var(--space-6);
    }

    .practical-engineering__intro {
      margin-top: var(--space-4);
    }

    .practical-engineering__divider {
      margin-top: var(--space-5);
    }

    .practical-engineering__label {
      margin-top: var(--space-4);
    }

    .practical-engineering__tags {
      margin-top: var(--space-3);
    }
  }
</style>
