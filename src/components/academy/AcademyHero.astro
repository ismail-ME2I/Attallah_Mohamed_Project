---
const supporting = "Practical automation learning, built from real-world engineering experience.";
---

<section class="academy-hero reveal" data-reveal aria-labelledby="academy-hero-heading">
  <div class="container">
    <h1 id="academy-hero-heading" class="academy-hero__heading">Easy Automation Academy</h1>
    <p class="academy-hero__supporting">{supporting}</p>
    <p class="academy-hero__credential">Built from Mohammed Attallah's field experience in industrial and energy automation.</p>
  </div>
</section>

<style>
  .academy-hero {
    padding-block: calc(var(--space-6) + 80px) var(--space-4);
  }

  .academy-hero__heading {
    display: inline-block;
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width-hairline) solid var(--color-accent-primary);
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-line);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    color: var(--color-text-primary);
  }

  .academy-hero__supporting {
    max-width: 60ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-secondary);
  }

  .academy-hero__credential {
    margin-top: var(--space-2);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .academy-hero {
      padding-block: calc(var(--space-7) + 80px) var(--space-5);
    }
  }
</style>
