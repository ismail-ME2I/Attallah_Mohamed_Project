---
import { courseDetail } from "../../data/courseDetail";
---

<section class="course-proof reveal" data-reveal aria-labelledby="course-proof-heading">
  <div class="container">
    <h2 id="course-proof-heading" class="course-proof__heading">Real-World Project Experience</h2>
    <div class="course-proof__card">
      <div class="course-proof__media">
        <img
          class="course-proof__image"
          src="/images/hero/hero-placeholder.svg"
          alt="Placeholder graphic marking the space reserved for the real Saudi substation project photograph, to be added once the asset is available."
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="course-proof__text">
        <p class="course-proof__meta">Saudi National Grid · 132/33/13.8 kV Substation</p>
        <p class="course-proof__intro">{courseDetail.projectIntro}</p>
        <div class="course-proof__divider" role="presentation"></div>
        <p class="course-proof__label">Scope</p>
        <ul class="course-proof__scope">
          {courseDetail.projectScope.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .course-proof {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .course-proof__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .course-proof__card {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
    background-color: var(--color-background-dark);
    border-radius: var(--radius-default);
    overflow: hidden;
  }

  .course-proof__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .course-proof__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .course-proof__text {
    padding: var(--space-4);
  }

  .course-proof__meta {
    /* text-inverse-muted, not accent-primary: accent-on-dark measures ~3.7:1,
       below the 4.5:1 AA minimum for normal text at this size. */
    font-family: var(--font-data);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-inverse-muted);
  }

  .course-proof__intro {
    max-width: 60ch;
    margin-top: var(--space-2);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-line);
    color: var(--color-text-inverse);
  }

  .course-proof__divider {
    margin-top: var(--space-4);
    border-top: var(--border-width-hairline) solid var(--border-color-inverse);
  }

  .course-proof__label {
    margin-top: var(--space-3);
    font-family: var(--font-data);
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-inverse-muted);
  }

  .course-proof__scope {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .course-proof__scope li {
    padding-block: var(--space-1);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-inverse-muted);
    border-top: var(--border-width-hairline) solid var(--border-color-inverse);
  }

  .course-proof__scope li:first-child {
    padding-top: 0;
    border-top: none;
  }

  @media (min-width: 768px) {
    .course-proof__card {
      flex-direction: row;
      align-items: stretch;
    }

    .course-proof__media {
      flex: 0 0 42%;
      aspect-ratio: auto;
    }

    .course-proof__text {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--space-6);
    }
  }
</style>
