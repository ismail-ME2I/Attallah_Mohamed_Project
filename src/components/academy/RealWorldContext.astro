---
import ExpertiseTags from "../ui/ExpertiseTags.astro";
import { academyRealWorldThemes } from "../../data/academyAudience";

const paragraph =
  "The Academy's content reflects real engineering work across substation automation, IEC 61850 and IEC 104 protocols, SCADA/HMI systems, IED integration, protocol analysis, and site commissioning — learning grounded in how these systems actually work in the field.";
---

<section class="real-world-context reveal" data-reveal aria-labelledby="real-world-context-heading">
  <div class="container">
    <h2 id="real-world-context-heading" class="real-world-context__heading">
      Grounded in Real Engineering Experience
    </h2>
    <p class="real-world-context__paragraph">{paragraph}</p>
    <div class="real-world-context__tags">
      <ExpertiseTags tags={academyRealWorldThemes} />
    </div>
  </div>
</section>

<style>
  .real-world-context {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .real-world-context__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .real-world-context__paragraph {
    max-width: 65ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-primary);
  }

  .real-world-context__tags {
    margin-top: var(--space-3);
  }

  @media (min-width: 1024px) {
    .real-world-context__paragraph {
      margin-top: var(--space-4);
    }

    .real-world-context__tags {
      margin-top: var(--space-4);
    }
  }
</style>
