---
import ExpertiseTags from "../ui/ExpertiseTags.astro";
import { academyAudience } from "../../data/academyAudience";
---

<section class="academy-audience reveal" data-reveal aria-labelledby="academy-audience-heading">
  <div class="container">
    <h2 id="academy-audience-heading" class="academy-audience__heading">Who This Is For</h2>
    <div class="academy-audience__tags">
      <ExpertiseTags tags={academyAudience} />
    </div>
  </div>
</section>

<style>
  .academy-audience {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .academy-audience__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .academy-audience__tags {
    margin-top: var(--space-3);
  }

  @media (min-width: 1024px) {
    .academy-audience__tags {
      margin-top: var(--space-4);
    }
  }
</style>
