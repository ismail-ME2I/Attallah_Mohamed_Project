---
import { audienceEntries } from "../../data/audience";
---

<section class="consulting-audience reveal" data-reveal aria-labelledby="consulting-audience-heading">
  <div class="container">
    <h2 id="consulting-audience-heading" class="consulting-audience__heading">Who This May Be Relevant For</h2>
    <div class="consulting-audience__grid">
      {
        audienceEntries.map((entry) => (
          <div class="consulting-audience__item">
            <h3 class="consulting-audience__item-heading">{entry.heading}</h3>
            <p class="consulting-audience__item-description">{entry.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .consulting-audience {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .consulting-audience__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  /* Quieter than Conversation Topics on purpose — no index numbers, no
     hairline rules between items, spacing alone carries the structure. */
  .consulting-audience__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .consulting-audience__item-heading {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .consulting-audience__item-description {
    /* text-secondary, not text-muted: at this body-sm size, text-muted
       measures ~3.76:1 on this background — below the 4.5:1 AA threshold
       for normal text. text-secondary (~7.7:1) keeps the section quiet
       relative to the heading while staying comfortably readable. */
    max-width: 52ch;
    margin-top: var(--space-1);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .consulting-audience__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
      row-gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .consulting-audience__grid {
      margin-top: var(--space-6);
    }
  }
</style>
