---
const caption =
  "Mohammed's field experience includes work on a 132/33/13.8 kV substation project in Saudi Arabia, part of the Saudi National Grid — spanning SCADA/HMI, IED integration, IEC 61850 gateways, and site testing and commissioning.";
---

<section class="consulting-proof reveal" data-reveal aria-labelledby="consulting-proof-heading">
  <div class="container">
    <h2 id="consulting-proof-heading" class="consulting-proof__heading">Real-World Project Experience</h2>
    <div class="consulting-proof__card">
      <div class="consulting-proof__media">
        <img
          class="consulting-proof__image"
          src="/images/hero/hero-placeholder.svg"
          alt="Placeholder graphic marking the space reserved for the real Saudi substation project photograph, to be added once the asset is available."
          width="960"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="consulting-proof__text">
        <p class="consulting-proof__caption">{caption}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .consulting-proof {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .consulting-proof__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .consulting-proof__card {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
    background-color: var(--color-background-dark);
    border-radius: var(--radius-default);
    overflow: hidden;
  }

  .consulting-proof__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .consulting-proof__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .consulting-proof__text {
    padding: var(--space-4);
  }

  .consulting-proof__caption {
    max-width: 60ch;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-inverse);
  }

  @media (min-width: 768px) {
    .consulting-proof__card {
      flex-direction: row;
      align-items: stretch;
    }

    .consulting-proof__media {
      flex: 0 0 38%;
      aspect-ratio: auto;
    }

    .consulting-proof__text {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--space-5);
    }
  }
</style>
