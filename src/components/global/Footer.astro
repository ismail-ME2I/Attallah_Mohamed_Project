---
const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Consulting", href: "/consulting" },
  { label: "Easy Automation Academy", href: "/easy-automation-academy" },
  { label: "Contact", href: "/contact" },
];

const year = new Date().getFullYear();

/*
  Confirmed per Sprint 04.1 project source research. Facebook remains
  omitted (unconfirmed, pending per D02).
*/
const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/mohammedattallah/" },
  { label: "YouTube", href: "https://youtube.com/@EasyAutomationTips" },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__row">
      <span class="site-footer__wordmark">Mohammed Attallah</span>
      <nav class="site-footer__nav" aria-label="Footer">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__row site-footer__row--meta">
      <p class="site-footer__copyright">© {year} Mohammed Attallah. All rights reserved.</p>
      <ul class="site-footer__social">
        {
          socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer">
                {social.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-background-secondary);
    margin-top: var(--space-6);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .site-footer__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__wordmark {
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-secondary);
  }

  .site-footer__nav a:hover {
    color: var(--color-accent-primary);
  }

  .site-footer__row--meta {
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-width-hairline) solid var(--border-color-default);
  }

  .site-footer__copyright {
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-muted);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    color: var(--color-text-muted);
  }

  .site-footer__social a:hover {
    color: var(--color-accent-primary);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      padding-block: var(--space-5);
    }

    .site-footer__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-footer__row--meta {
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
