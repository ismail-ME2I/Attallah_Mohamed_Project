---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="expertise-tags">
  {
    tags.map((tag) => (
      <li class="expertise-tags__item">
        <span class="expertise-tags__label">{tag}</span>
      </li>
    ))
  }
</ul>

<style>
  /*
    Quiet, outline-only tags — deliberately not a clickable-looking tag cloud
    or dashboard chip set (D06 Section 15).
  */
  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .expertise-tags__item {
    display: flex;
  }

  .expertise-tags__label {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border: var(--border-width-hairline) solid var(--border-color-default);
    border-radius: var(--radius-default);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-primary);
  }
</style>
