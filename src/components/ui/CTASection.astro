---
import Button from "./Button.astro";

interface Props {
  heading: string;
  qualifier?: string;
  paragraph: string;
  ctaLabel: string;
  ctaHref: string;
  ctaVariant?: "primary" | "secondary";
  wide?: boolean;
}

const { heading, qualifier, paragraph, ctaLabel, ctaHref, ctaVariant = "secondary", wide = false } = Astro.props;
const headingId = `cta-heading-${heading.replace(/\s+/g, "-").toLowerCase()}`;
---

<section
  class:list={["cta-section", "reveal", { "cta-section--wide": wide }]}
  data-reveal
  aria-labelledby={headingId}
>
  <div class="container">
    <div class="cta-section__heading-row">
      <h2 id={headingId} class="cta-section__heading">
        {heading}
      </h2>
      {qualifier && <span class="cta-section__qualifier">{qualifier}</span>}
    </div>
    <p class="cta-section__paragraph">{paragraph}</p>
    <Button href={ctaHref} variant={ctaVariant} class="cta-section__cta">
      {ctaLabel}
    </Button>
  </div>
</section>

<style>
  .cta-section {
    scroll-margin-top: 80px;
    padding-block: var(--space-4);
  }

  .cta-section__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
  }

  .cta-section__heading {
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    font-weight: var(--text-h2-weight);
    color: var(--color-text-primary);
  }

  .cta-section__qualifier {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-secondary);
  }

  .cta-section__paragraph {
    max-width: 60ch;
    margin-top: var(--space-3);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-primary);
  }

  /* Opt-in only (via the `wide` prop) — every other CTASection instance
     keeps the default 60ch above untouched. Widens the reading measure
     modestly (still within comfortable line-length range) so this
     instance doesn't read as a narrow column in a much wider section,
     without turning it into a full content-width block. */
  .cta-section--wide .cta-section__paragraph {
    max-width: 75ch;
  }

  :global(.cta-section__cta) {
    margin-top: var(--space-4);
  }

  @media (min-width: 1024px) {
    .cta-section__paragraph {
      margin-top: var(--space-4);
    }

    :global(.cta-section__cta) {
      margin-top: var(--space-5);
    }
  }
</style>
